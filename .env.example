# .env.example - Copy to .env and configure

# System Configuration
SYSTEM_LOG_LEVEL=INFO
SYSTEM_DATA_DIR=data
SYSTEM_OUTPUT_DIR=output
SYSTEM_MAX_CONCURRENT_WORKFLOWS=5
SYSTEM_ENABLE_CACHING=true

# Agent Configuration
AGENT_SCOUT_PREVIEW_LENGTH=500
AGENT_SCOUT_EXTRACT_METADATA=true
AGENT_SCOUT_ANALYZE_STRUCTURE=true

AGENT_MAKER_TRANSFORMATION_TYPE=summarization
AGENT_MAKER_MAX_OUTPUT_LENGTH=1000
AGENT_MAKER_MODEL=default

AGENT_CHECKER_MIN_QUALITY_SCORE=0.5
AGENT_CHECKER_STRICT_MODE=false

AGENT_CURATOR_RETRY_ON_FAILURE=false
AGENT_CURATOR_MAX_RETRIES=3

# Workflow Configuration
WORKFLOW_WORKFLOW_DIR=workflows/templates
WORKFLOW_ENABLE_PARALLEL_EXECUTION=false
WORKFLOW_MAX_WORKFLOW_DURATION_SECONDS=300
WORKFLOW_SAVE_INTERMEDIATE_RESULTS=true

# API Credentials (for AI post-processing in OCR)
# Get your Anthropic API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Get your OpenAI API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
